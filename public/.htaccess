# Site estático (Next.js `output: "export"`) — Hostinger (LiteSpeed/Apache).
# Este arquivo é copiado para `out/.htaccess` no build e vai junto para o public_html.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS e domínio sem "www" ---------------------------------------------
  # Só funciona depois que o SSL estiver ativo no domínio (na Hostinger é automático).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://drlucasfraga.com.br%{REQUEST_URI} [R=301,L,NE]

  # --- Endereços do site anterior (WordPress) → novas seções ------------------
  # Preserva links antigos e SEO. [NE] mantém o "#" da âncora.
  RewriteRule ^sobre-mim/?$                    /#sobre       [R=301,L,NE]
  RewriteRule ^dor-no-ombro-e-cotovelo/?$      /#ombro       [R=301,L,NE]
  RewriteRule ^locais-de-atendimento/?$        /#contato     [R=301,L,NE]
  RewriteRule ^fale-conosco/?$                 /#contato     [R=301,L,NE]
  RewriteRule ^blog/?$                         /conteudos/   [R=301,L]
  RewriteRule ^blog/page/[^/]+/?$              /conteudos/   [R=301,L]
  RewriteRule ^conteudos/author/[^/]+/?$       /conteudos/   [R=301,L]
  RewriteRule ^feed/?$                         /conteudos/   [R=302,L]

  # Artigos do site anterior ainda não migrados (lista em content/articles.ts → legacyArticleSlugs)
  RewriteRule ^conteudos/(a-rotina-inimiga-descubra-como-habitos-comuns-podem-sabotar-a-saude-do-seu-ombro-e-cotovelo|artroscopia-do-ombro-o-que-e-e-como-funciona-o-tratamento-minimamente-invasivo|cisto-sinovial|clavicula-quebrada|corrida-e-lesoes-no-cotovelo-e-ombro-causas-e-prevencao|crossfit-e-lesoes-no-ombro-como-prevenir-e-tratar|desvendando-as-causas-ocultas-dos-problemas-no-ombro-e-cotovelo|dor-no-braco-direito|dor-no-braco-esquerdo|dor-no-ombro|epicondilite-cotovelo-de-tenista-causas-e-tratamentos|epicondilite-tratamento|estresse-postura-e-saude-do-ombro-e-cotovelo|evite-cirurgias-como-o-fortalecimento-muscular-pode-proteger-suas-articulacoes|lesao-slap-no-ombro-diagnostico-tratamento-e-recuperacao-para-atletas|lesoes-no-ombro-como-identificar-e-quando-procurar-um-ortopedista|luxacao-do-ombro-o-que-fazer-e-como-tratar|luxacao-recorrente-do-ombro-causas-sintomas-e-quando-e-hora-de-operar|tecnicas-regenerativas-alternativas-modernas-para-tratar-dor-no-ombro-e-cotovelo|tendinite-no-ombro-tratamentos-modernos-para-alivio-rapido|tratamento-regenerativo-para-dores-no-ombro-uma-alternativa-minimamente-invasiva)/?$ /conteudos/ [R=301,L]

  # --- Barra final (trailingSlash: true) --------------------------------------
  # /conteudos → /conteudos/ quando a pasta existe.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# --- Cache ------------------------------------------------------------------------
<IfModule mod_headers.c>
  # JS/CSS/fontes do Next têm hash no nome: nunca mudam.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Imagens mantêm o mesmo nome se forem trocadas: cache de 7 dias.
  <FilesMatch "\.(avif|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml|webmanifest|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
